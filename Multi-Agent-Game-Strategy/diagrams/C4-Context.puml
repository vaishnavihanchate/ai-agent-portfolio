@startuml C4-Context

title Multi-Agent Game Strategy - System Context

actor Player

rectangle "Multi-Agent Game Strategy System" as System {
    rectangle "BFS / DFS Search" as Search
    rectangle "Agent Coordinator" as Agent
}

rectangle "Game Environment" as Environment

Player --> System : Provides game input
System --> Environment : Reads game state
Environment --> System : Returns game state
System --> Player : Returns result

@enduml