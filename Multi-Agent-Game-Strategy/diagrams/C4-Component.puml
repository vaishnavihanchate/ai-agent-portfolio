@startuml C4-Component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Multi-Agent Game Strategy - Component Level

Container_Boundary(searchEngine, "Search Engine") {

    Component(frontier, "Frontier Manager", "Python", "Manages BFS queue and DFS stack")

    Component(visited, "Visited Manager", "Python", "Tracks visited nodes")

    Component(goal, "Goal Test", "Python", "Checks whether target is reached")

    Component(path, "Path Manager", "Python", "Builds the final path")
}

Rel(frontier, visited, "Checks visited nodes")
Rel(frontier, goal, "Checks target")
Rel(goal, path, "Provides result")
Rel(visited, frontier, "Prevents repeated visits")

@enduml